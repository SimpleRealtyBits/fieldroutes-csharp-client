<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>FieldRoutesApiClient</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PackageId>FieldRoutesApiClient</PackageId>
        <Version>1.0.2</Version>
        <Description>Typed FieldRoutes (PestRoutes) API client. Generated from api.md; injectable
            via AddFieldRoutesClient.</Description>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="tests/**" />
        <EmbeddedResource Remove="tests/**" />
        <None Remove="tests/**" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="FieldRoutesApiClient.Tests" />
    </ItemGroup>

</Project>